# Copiar a .env para configuración local. Node carga este archivo automáticamente.
PORT=3001
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# PostgreSQL local: postgresql://postgres:TU_CLAVE_URL_ENCODED@localhost:5432/farmacia
# En nube: URL PostgreSQL del proveedor. Si se deja vacío, usa SQLite local.
DATABASE_URL=
DATABASE_SSL=false
# Credencial inicial para una instalación nueva. Cambiar antes de publicar.
ADMIN_EMAIL=admin@farmacia.gt
ADMIN_PASSWORD=Farmacia2026!
DEMO_MODE=true
# Producción: clave AES de 64 caracteres hexadecimales. No cambiar tras cifrar datos.
DATA_ENCRYPTION_KEY=
# React y API se publican bajo el mismo dominio HTTPS.
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
